# TowWise Environment Configuration

# 1. Feedback Database (MongoDB Atlas)
# Dedicated database connection string for user feedback, missing vehicle requests, and contact messages.
# If omitted, feedback will be logged serverless to the server console.
FEEDBACK_DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/TowWise_Feedback?retryWrites=true&w=majority

# 2. Towing Capacity Database (Optional)
# TowWise includes an embedded catalog of 2015–2024 vehicle specs with NHTSA auto-enrichment.
# If you have an external MongoDB collection of towing capacities, specify it here:
# TOWING_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/TowWise_Capacities?retryWrites=true&w=majority
